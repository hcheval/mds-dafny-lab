{
  "name": "Dafny Lab",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "wget -q https://github.com/dafny-lang/dafny/releases/download/v4.11.0/dafny-4.11.0-x64-ubuntu-22.04.zip && unzip -q dafny-4.11.0-x64-ubuntu-22.04.zip -d $HOME/dafny && echo 'export PATH=$HOME/dafny/dafny:$PATH' >> ~/.bashrc",
  "customizations": {
    "vscode": {
      "extensions": [
        "dafny-lang.ide-vscode"
      ]
    }
  }
}
